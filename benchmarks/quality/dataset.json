    {
      "key": "q-001",
      "text": "Which SI base unit is defined using exactly 9 192 631 770 periods of the caesium-133 transition?",
      "expected": [
        {
          "documentKey": "second",
          "sequence": 0
        }
      ]
    },
    {
      "key": "q-002",
      "text": "Which SI length unit follows from fixing vacuum light speed at 299 792 458 units per second?",
      "expected": [
        {
          "documentKey": "metre",
          "sequence": 0
        }
      ]
    },
    {
      "key": "q-003",
      "text": "Which SI mass unit is realized by fixing the numerical value of the Planck constant?",
